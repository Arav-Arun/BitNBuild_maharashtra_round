# live: hosted LLM + downloaded research documents (requires GROQ_API_KEY)
# offline: deterministic travel test runner; recorded: existing responses only
MODE=live
DATA_DIR=data
LLM_BASE_URL=https://api.groq.com/openai/v1
AGENT_MODEL=openai/gpt-oss-20b
JUDGE_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=
# Local web browser API target. On Vercel set this to the public Render API URL.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000
